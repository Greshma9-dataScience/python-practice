intersection()

difference()


💻 Practice Code

1️⃣ add() – Add an Element

fruits = {"Apple", "Banana"}

fruits.add("Mango")
print(fruits)

Output

{'Apple', 'Banana', 'Mango'}


---

2️⃣ update() – Add Multiple Elements

fruits = {"Apple", "Banana"}

fruits.update(["Orange", "Grapes"])
print(fruits)

Output

{'Apple', 'Banana', 'Orange', 'Grapes'}


---

3️⃣ remove() and discard()

fruits = {"Apple", "Banana", "Mango"}

fruits.remove("Banana")
fruits.discard("Orange")  # No error if item doesn't exist

print(fruits)

Output

{'Apple', 'Mango'}


---

4️⃣ pop() and clear()

colors = {"Red", "Blue", "Green"}

colors.pop()
print(colors)

colors.clear()
print(colors)

Output

{'Blue', 'Green'}
set()


