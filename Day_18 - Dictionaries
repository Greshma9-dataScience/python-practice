2️⃣ Accessing Dictionary Values

student = {
    "name": "Veshma",
    "age": 21,
    "course": "Python"
}

print(student["name"])
print(student["course"])

#Output
Veshma
Python

3️⃣ Adding & Updating Items
student = {
    "name": "Veshma",
    "age": 21
}

student["course"] = "Data Analytics"
student["age"] = 22

print(student)

#Output
{'name': 'Veshma', 'age': 22, 'course': 'Data Analytics'}

4️⃣ Removing Items
student = {
    "name": "Veshma",
    "age": 22,
    "course": "Data Analytics"
}

student.pop("age")

print(student)

#Output
{'name': 'Veshma', 'course': 'Data Analytics'}


5️⃣ Loop Through a Dictionary
student = {
    "name": "Veshma",
    "age": 22,
    "course": "Data Analytics"
}

for key, value in student.items():
    print(key, ":", value)
Output
name : Veshma
age : 22
course : Data Analytics

